{
  "name": "vibe-wormholesurfing",
  "version": "0.1.0",
  "private": true,
  "description": "Surf through a wormhole on a cute spaceship and warp into strange worlds full of treasure.",
  "author": "FionaPreroll <fipreroll+app@gmail.com>",
  "type": "module",
  "main": "desktop/build/main.cjs",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.core.json && tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.desktop.json --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "pnpm build && playwright test",
    "screenshots": "pnpm build && playwright test -c playwright.screenshots.config.ts",
    "test:soak": "pnpm build && playwright test -c playwright.soak.config.ts",
    "icons": "node --experimental-strip-types tools/icons.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "android:sync": "pnpm build && cap sync android",
    "desktop": "pnpm build && tsc -p tsconfig.desktop.json && electron .",
    "desktop:pack": "pnpm build && tsc -p tsconfig.desktop.json && electron-builder --dir",
    "desktop:dist": "pnpm build && tsc -p tsconfig.desktop.json && electron-builder --publish never",
    "test:desktop": "pnpm desktop:pack && playwright test -c playwright.desktop.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@fionapreroll/app-updates": "https://github.com/FionaPreroll/vibe-p2pgame/releases/download/app-updates-v0.1.0/fionapreroll-app-updates-0.1.0.tgz",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@preact/signals": "^2.11.3",
    "@preact/signals-core": "^1.14.4",
    "idb-keyval": "^6.3.0",
    "preact": "^11.0.2",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@biomejs/biome": "2.6.3",
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^24.19.2",
    "@types/three": "^0.187.0",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "happy-dom": "^21.0.4",
    "monocart-coverage-reports": "3.2.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
